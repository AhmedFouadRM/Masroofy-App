  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"seed_key\" TEXT NULL UNIQUE, \"name\" TEXT NULL, \"kind\" TEXT NOT NULL DEFAULT 'expense' CHECK(\"kind\" IN ('expense', 'income')), \"icon\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, \"sort_order\" INTEGER NOT NULL, \"is_hidden\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_hidden\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), CHECK ((seed_key IS NULL) <> (name IS NULL)));"
        }
      ]
    },
    {
      "name": "recurring_expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recurring_expenses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NOT NULL, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"frequency\" TEXT NOT NULL CHECK(\"frequency\" IN ('daily', 'weekly', 'monthly', 'yearly')), \"start_date\" TEXT NOT NULL, \"next_due_date\" TEXT NOT NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "expenses",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"expenses\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"title\" TEXT NULL, \"amount_minor\" INTEGER NOT NULL CHECK(\"amount_minor\" > 0), \"category_id\" INTEGER NOT NULL REFERENCES categories (id) ON DELETE RESTRICT, \"date\" TEXT NOT NULL, \"note\" TEXT NULL, \"recurring_expense_id\" INTEGER NULL REFERENCES recurring_expenses (id) ON DELETE SET NULL, \"occurrence_date\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), UNIQUE (\"recurring_expense_id\", \"occurrence_date\"));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"budgets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"category_id\" INTEGER NOT NULL UNIQUE REFERENCES categories (id) ON DELETE CASCADE, \"limit_minor\" INTEGER NOT NULL CHECK(\"limit_minor\" > 0), \"period\" TEXT NOT NULL CHECK(\"period\" IN ('weekly', 'monthly')), \"last_alerted_period_start\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
